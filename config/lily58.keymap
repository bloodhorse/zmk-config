 * SPDX-License-Identifier: MIT
 *
 * MIRROR of the live board state as managed by ZMK Studio.
 * Source of truth is the Studio flash settings on the board itself; this file
 * is the backup/documentation copy, dumped over Studio RPC (tools/zmkctl.py).
 * If reflashed, Studio's saved state still overrides these defaults — which is
 * also the day this file starts mattering, so it has to be true before a build.
 *
 * Verified cell-by-cell against the board 2026-09-12: all 58 positions on all
 * five bound layers compared as numeric (page, id, mods), not display names.
 * Edits made in the Studio GUI do NOT reach this file — re-verify after any.
 * bekh edits in Studio often, so the working order is always: dump the board,
 * then change it, then bring this file up to it. Never edit from memory.
 *
 * Six bound layers since 2026-09-12: slot 5 was added by hand in Studio while
 * chasing a rename, could not be deleted by Studio or the RPC api, and then
 * turned out to be the only slot FUCK could live in (slot 4 belongs to the
 * conditional_layers node — see there). Layer NAMES are Studio-GUI-only and
 * this file cannot set them on a live board; read them back from
 * get_keymap_bytes before trusting the display-name here.
 *
 * HEAVEN pos 2 is a bare keyboard-page usage 0xCE (Keypad @), which macOS
 * ignores. It reads like a Studio slip that ate the old F15 (and F14 next to
 * it) rather than a decision; recorded here as-is because this file's job is
 * to say what the board does, not what it ought to.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Tap-toggle duals for slow, deliberate keys only (thumbs/layer keys) —
        // hold resolves instantly via balanced flavor when chorded, tap fires on
        // clean press-release. Board-wide doctrine stays: no hold-taps on typing keys.
        // Nothing binds the gtog ladder at the moment; it stays compiled in
        // because pruning a behavior shifts every id above it, and Studio's
        // saved bindings reference ids. Dead weight is cheaper than a reshuffle.
        gtog: gui_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
        // Tapping-term ladder — same behavior at faster terms, so tuning the
        // hold-engage delay is a runtime rebind (Studio/RPC), never a reflash.
        gtog180: gui_tap_toggle_180 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&tog>;
        };
        gtog160: gui_tap_toggle_160 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            bindings = <&kp>, <&tog>;
        };
        gtog140: gui_tap_toggle_140 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            bindings = <&kp>, <&tog>;
        };
        // Thumb hold-layers — balanced regime, 2026-08-31. The previous design
        // (hold-preferred + a compiled position whitelist, zero clocks) made
        // every key added to a layer a whitelist edit -> rebuild -> flash both
        // halves. That tax lost: bekh types slowly now, so a timer's misfire
        // window is cheap, and with no whitelist every position is
        // layer-capable — layer content is pure Studio RPC, forever.
        //
        // balanced semantics:
        //   other key pressed AND released while thumb is down -> hold, no wait
        //   thumb released first (fast roll)                   -> tap
        //   thumb held alone past the term                     -> hold
        //   thumb released alone within the term               -> tap, on release
        //
        // The term's only real job is how long a solo press may dwell before
        // the tap is forfeited: spaces vanishing = raise it. quick-tap-ms:
        // tap, then press again within 200ms -> forced tap, held = key repeat.
        //
        // Five rungs so tuning the term is a runtime rebind (Studio RPC),
        // never a reflash — the gtog ladder trick. ltb280 is the default;
        // one behavior serves both thumbs (the layer is a binding parameter).
        // Prune = behavior IDs shift under Studio's saved bindings; don't.
        ltb200: layer_tap_balanced_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb240: layer_tap_balanced_240 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb280: layer_tap_balanced_280 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb320: layer_tap_balanced_320 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <320>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb360: layer_tap_balanced_360 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <360>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        motog: momentary_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    // Both thumb layers held together open slot 4. Indices are FIRMWARE layer
    // slots: 1=CURSE, 2=HEAVEN, 4 = the first reserved slot (was extra_2).
    //
    // THIS NODE OWNS SLOT 4. ZMK's conditional_layers listener runs on every
    // layer state change and, when the if-layers are not all held, DEACTIVATES
    // the then-layer — so no other door can open it: an `&mo 4` (or a hold-tap
    // to 4) turns slot 4 on and the listener turns it off in the same tick.
    // Learned 2026-09-12: FUCK was first bound into slot 4 with a backtick-held
    // door and the door silently did nothing. FUCK moved to slot 5.
    // Slot 4 is empty now (the alt-arrow word-jump cross it carried as LIMBO
    // was erased the same day). Dropping or retargeting this node is a build;
    // until then Space+Enter opens an empty layer whose cells fall through.
    // If layers are ever re-mirrored/reordered, re-check these numbers before
    // trusting them.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        limbo_tri {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   ]   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// | `/FUCK|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   ?   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   =    |  |   -   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                      | SHIT |LCTRL | LGUI |SPC/CUR |  |RET/HVN| RGUI | BSPC  | SHIT  |
//
// LAYER DOORS — the base layer carries no plain &mo to CURSE or HEAVEN.
// Both live exclusively on the thumb hold-taps: Space (pos 53) holds CURSE,
// Enter (pos 54) holds HEAVEN, and holding both opens slot 4 (empty) via the
// conditional_layers node. pos 11 (was &mo 2) is ']'.
// Consequence worth knowing: if a thumb hold-tap ever misbehaves, there is no
// fallback route to CURSE or HEAVEN except HEAVEN's own &tog 1 at pos 55.
//
// pos 24, the home-row pinky, is the backtick on tap and the FUCK door on hold
// (ltb280, same rung as the thumbs) — 2026-09-12. Backtick is rare enough
// that losing key-repeat on it costs nothing; a ``` fence is three taps.
// Pinky-hold + same-hand home row is the shift-chord shape, and the whole
// point is a left-hand-only cmd+digit: bekh's right hand is on the mouse.
//
// thumbs (set in Studio 2026-09-08, mirrored from the board): 'shit' has a
// door on each outer thumb (pos 50 and 57), LCTRL at 51, LGUI at 52, RGUI at
// 55. No Alt on the base layer — alt chords go through CURSE's LA() cells.
//
// pos 35 (never RCTRL in practice) is '?' — LS(N7), literally the ЙЦУКЕН chord,
// just folded onto one key. It had to be a MODIFIER seat: modifiers don't change
// with the host input source, so this is the only free real estate that stays
// free in both layouts. Every symbol seat is a live Cyrillic letter under
// ЙЦУКЕН — '[' is х (5.5/day), ';' is ж, '/' is '.' — and the two genuinely
// dead ones (']' 2.1, ъ 0.6) sit in the worst reach on the board.
// See stats/keycount-2026-07.md.
// Under a US input source this key types '&'. The board cannot see the layout;
// cross-layout '?' would need Karabiner's input_source_if.
//
// This lived in Karabiner for one afternoon; Karabiner was instant but kept a
// second copy of both layers in scancodes — two sources of truth, one of which
// was going to rot. Firmware won, first as hold-preferred + whitelist, since
// 2026-08-31 as the balanced ladder (Studio can set a hold-tap's parameters
// but never its flavor or term, hence five compiled rungs).
//
// F13 left the board entirely: it is RAlt+H in Karabiner now, so the
// superwhisper trigger is a right-thumb chord instead of a pinky-corner hold.
//
// Arrows also live on RAlt + I/J/K/L in Karabiner (mod stripped, so the OS sees
// a bare arrow — aerospace never fires). HEAVEN keeps its own arrow cross as
// the fallback path whenever Karabiner is off.
            display-name = "ground";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp RBKT
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y  &kp U    &kp I     &kp O   &kp P    &kp LBKT
&ltb280 5 GRAVE &kp A &kp S &kp D &kp F  &kp G                         &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp LS(N7)
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp EQUAL   &kp MINUS  &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &mo 3    &kp LCTRL &kp LGUI &ltb280 1 SPACE   &ltb280 2 RET &kp RGUI &kp BSPC &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        curse_layer {
// ------------------------------------------------------------------------------------------------------------
// |LA(ESC)|LA(1)|LA(2)|LA(3) |LA(4) |LA(5) |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |LA(TAB)| F11 | F12 |LS+LA(F)|LA(R)| RET |                   |      |   7   |   8   |  9   |       |  F12  |
// |       |LA(A)|LA(S)|LA(D) |LA(F) |LA(G) |                   |      |   4   |   5   |  6   |       |       |
// | CAPS  |LG(K)|LG(I)| F17  |LA(V) |LA(B) |LA(SPC) |  |       |      |   1   |   2   |  3   |       |       |
//                      |      |      |  S   |   `    |  |   '   |  0   |LA(BSPC)|  KP. |
//
// Left hand is aerospace: LA(letter) window/workspace commands, LA(ESC)+LA(1-5)
// for workspace switching. Right hand is the numpad.
// CAPS squats on the left shift seat (pos 36) — that is why a left-shifted
// chord has to be pressed shift-before-Space; right shift composes in any order.
// pos 37/38 LG(K)/LG(I) and pos 52 plain S: Studio GUI edits by bekh, found by
// verify and mirrored 2026-09-12 (52 was LG(Q) here before).
            display-name = "CURSE";
            bindings = <
&kp LA(ESC) &kp LA(N1) &kp LA(N2) &kp LA(N3)    &kp LA(N4) &kp LA(N5)                     &kp F6  &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&kp LA(TAB) &kp F11    &kp F12    &kp LS(LA(F)) &kp LA(R)  &kp RET                        &trans  &kp N7 &kp N8 &kp N9 &trans  &kp F12
&trans      &kp LA(A)  &kp LA(S)  &kp LA(D)     &kp LA(F)  &kp LA(G)                      &trans  &kp N4 &kp N5 &kp N6 &trans  &trans
&kp CAPS    &kp LG(K)  &kp LG(I)  &kp F17       &kp LA(V)  &kp LA(B) &kp LA(SPACE) &trans &trans  &kp N1 &kp N2 &kp N3 &trans  &trans
                                  &trans        &trans     &kp S     &kp GRAVE     &kp SQT &kp N0 &kp LA(BSPC) &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        heaven_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     | KP@ |      |      |      |                   |BT_CLR|BT_SEL0|BT_PRV |BT_NXT|   ]   |  KP+  |
// |       |     |     |      |      |      |                   |LA(Y) |LA+LG(U)|  ^   |      |       |       |
// |       |     |     |      |      |      |                   |LA(<-)|  <-   |   v   |  ->  |LA(->) |       |   inverted-T arrow cross
// |       |     |     |      |      |      |        |  |  F16  | F13  |  F18  |   |   |LG(I) |   K   |       |
//                      |      |      |      |    `   |  |   '   | tog1 |  DEL  |       |
//
// tog1 at pos 55 is the numpad latch — and it is the ONE door to CURSE that
// does not go through a thumb hold-tap, so it doubles as the escape hatch.
// Reachable now that HEAVEN is held on the opposite thumb (pos 54).
// pos 19 LA(LG(U)), pos 47 LG(I), pos 48 plain K: Studio GUI edits by bekh,
// found by verify and mirrored 2026-09-12.
            display-name = "HEAVEN";
            bindings = <
&trans  &trans  &kp 0x700CE &trans &trans &trans                &bt BT_CLR   &bt BT_SEL 0 &bt BT_PRV  &bt BT_NXT   &kp RBKT &kp KP_PLUS
&trans  &trans  &trans  &trans &trans &trans                    &kp LA(Y)    &kp LA(LG(U)) &kp UP     &trans       &trans &trans
&trans  &trans  &trans  &trans &trans &trans                    &kp LA(LEFT) &kp LEFT     &kp DOWN    &kp RIGHT    &kp LA(RIGHT) &trans
&trans  &trans  &trans  &trans &trans &trans &trans   &kp F16   &kp F13      &kp F18      &kp LS(BSLH) &kp LG(I)   &kp K  &trans
                        &trans &trans &trans &kp GRAVE   &kp SQT   &tog 1     &kp DEL      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        shit_layer {
// ------------------------------------------------------------------------------------------------------------
// The junk drawer, firmware slot 3. Was 'media' until it was deleted in the
// Studio kitchen and came back on the 2026-09-01 reflash with firmware
// defaults; bekh renamed it and bolted doors on it (&mo 3 on both outer
// thumbs, pos 50 and 57), which is what turned it from an inert slot into the
// layer he actually reaches.
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |  F12  |
// |       |     |     |LG(K) |      |      |                   |      |       |       |      |       |       |
// |       |     |LC(L)|LG(I) |      |      |        |  |       |      |       |       |      |       |       |
//
// SYMBOL ROW (2026-09-08): shift+digit baked into each cell, seated one row
// under the digit it belongs to, so the layer reads as a second number row
// with the shift pre-pressed. It replaces nothing on the base and needs no
// build — ten &kp cells. LC(L)/LG(I) were in the way at pos 14/15 and moved
// straight down two rows to pos 38/39, same columns, nothing lost.
//
// The '&' cell (pos 19) is RS(N7), not LS(N7), and that is load-bearing:
// Karabiner rule 12 ("shift+7 → ?") is keyed on LEFT shift specifically, so a
// board LS(N7) gets rewritten to '?' under EN — which is exactly what base
// pos 35 relies on. Right shift slides past the rule and '&' comes out.
// RS(N7) is not a member of zmk_studio_api's Keycode enum, so `zmkctl kp`
// cannot write it; it went in as a raw Key Press:
//   zmkctl set 3 19 "Key Press" $((0x20070024)) 0
//
// CROSS-LANGUAGE, unsolved and deferred by bekh: five of these ten change glyph
// under ЙЦУКЕН (@→" #→№ $→; ^→: &→?). The fix is the custom .keylayout in
// docs/musings_over_ru_layout.md, not anything on the board.
//
// 2026-09-08: the whole num row was media/brightness consumer-page usages
// (BRI_DN/BRI_UP, keyboard illumination, VOL/RW/PLAY/FF/MUTE); wiped for F1-F12.
// F1-F10 sit under the digit they are named after — that alignment is the whole
// point. The two overflow keys stack down the right edge in order: F11 on the
// ']' corner (pos 11), F12 directly under it on the '[' seat (pos 23) — reading
// order continues off the end of the row and turns down, so the sequence stays
// countable. F11 sat on the ESC corner for a few hours and bekh hated it: the
// ESC corner is muscle memory for ESC, and the layer key is on the same hand.
// The ESC corner is &trans so ESC still works with the layer held.
// Volume survives on the rotary encoder (sensor-bindings, every layer).
            display-name = "shit";
            bindings = <
&trans  &kp F1 &kp F2 &kp F3   &kp F4    &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&none  &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)    &kp LS(N6) &kp RS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp F12
&trans &trans &trans &kp LG(K) &trans    &trans                  &trans &trans &trans &trans  &trans  &trans
&none  &none  &kp LC(L) &kp LG(I) &none  &none  &none    &none   &none  &none  &none  &none   &none   &none
                     &none     &none     &none  &none    &none   &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        limbo_layer {
// ------------------------------------------------------------------------------------------------------------
// Firmware slot 4 (was extra_2, a reserved slot Studio activated). EMPTY.
// Opens only as the conditional layer, Space + Enter held together, and the
// conditional_layers node owns it — nothing else can open it (see the node).
// It carried the alt-arrow word-jump cross (pos 20/31/32/33) as LIMBO until
// 2026-09-12; Studio had silently renamed it 'WELL', bekh renamed it FUCK,
// the cross was erased, cmd+digit went in — and the door never opened. FUCK
// moved to slot 5; the five cells and four arrow seats here are explicit
// &none on the board, the rest is behavior id 0 (zeroed reserved-layer
// bindings), all written as &none. bekh renames it back in Studio at leisure.
// This block only becomes the firmware default on the next build.
            display-name = "LIMBO";
            bindings = <
&none &none &none &none &none &none                              &none &none &none &none &none &none
&none &none &none &none &none &none                              &none &none &none &none &none &none
&none &none &none &none &none &none                              &none &none &none &none &none &none
&none &none &none &none &none &none &none                &none   &none &none &none &none &none &none
                  &none &none &none &none                &none   &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fuck_layer {
// ------------------------------------------------------------------------------------------------------------
// FUCK, firmware slot 5 (was extra_3, a reserved slot Studio activated by
// hand 2026-09-12 — added while chasing a rename, undeletable, then the only
// slot that could take this layer, since slot 4 is the conditional node's).
// Door: backtick held (pos 24, ltb280; tap is still the backtick).
// cmd+digit for tab switching: cmd+1..5 on the left home row, each under the
// digit it sends, left hand only — the right hand is on the mouse, and
// cmd+number-row was the stretch this layer exists to kill.
// Physical keys, in Gallium: hold ` and press n r t s g.
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |LG(1)|LG(2)|LG(3) |LG(4) |LG(5) |                   |      |       |       |      |       |       |
//
// Everything else is behavior id 0 on the board — zeroed bindings in a
// never-defined reserved layer — written here as &none. NOTE: this block only
// becomes the firmware default on the next build; today FUCK exists solely in
// Studio flash settings, so a settings_reset before a rebuild would lose it.
            display-name = "FUCK";
            bindings = <
&none &none      &none      &none      &none      &none                  &none &none &none &none &none &none
&none &none      &none      &none      &none      &none                  &none &none &none &none &none &none
&none &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)             &none &none &none &none &none &none
&none &none      &none      &none      &none      &none  &none    &none  &none &none &none &none &none &none
                  &none &none &none &none                        &none   &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
