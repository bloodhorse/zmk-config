 * SPDX-License-Identifier: MIT
 *
 * MIRROR of the live board state as managed by ZMK Studio.
 * Source of truth is the Studio flash settings on the board itself; this file
 * is the backup/documentation copy, dumped over Studio RPC (tools/zmkctl.py).
 * If reflashed, Studio's saved state still overrides these defaults — which is
 * also the day this file starts mattering, so it has to be true before a build.
 *
 * Verified cell-by-cell against the board 2026-08-29: all 58 positions on all
 * four bound layers compared as numeric (page, id, mods), not display names.
 * Edits made in the Studio GUI do NOT reach this file — re-verify after any.
 *
 * HEAVEN pos 2 is a bare keyboard-page usage 0xCE (Keypad @), which macOS
 * ignores. It reads like a Studio slip that ate the old F15 (and F14 next to
 * it) rather than a decision; recorded here as-is because this file's job is
 * to say what the board does, not what it ought to.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Tap-toggle duals for slow, deliberate keys only (thumbs/layer keys) —
        // hold resolves instantly via balanced flavor when chorded, tap fires on
        // clean press-release. Board-wide doctrine stays: no hold-taps on typing keys.
        gtog: gui_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
        // Tapping-term ladder — same behavior at faster terms, so tuning the
        // hold-engage delay is a runtime rebind (Studio/RPC), never a reflash.
        gtog180: gui_tap_toggle_180 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&tog>;
        };
        gtog160: gui_tap_toggle_160 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            bindings = <&kp>, <&tog>;
        };
        gtog140: gui_tap_toggle_140 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            bindings = <&kp>, <&tog>;
        };
        motog: momentary_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |HEAVEN |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   ?   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   =    |  |   -   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                      |CURSE | GUI  | ALT  |SPC/CUR |  |RET/HVN| RALT | BSPC  | RGUI  |
// thumbs 2026-08-01: LAlt owns the prime left seat (aerospace lives on alt — top
// measured modifier, ~260 chords/day, one-handed left by requirement), cmd beside
// it, CURSE at the outer corner. Right half: HEAVEN keeps the prime seat; RGUI
// replaced RAlt on the outer thumb (cross-hand cmd chording; right-alt was dead —
// superwhisper moved off the right-alt tap to F13 long ago).
// pos 35 (was RCTRL, unused) is '?' — LS(N7), literally the ЙЦУКЕН chord, just
// folded onto one key. It had to be a MODIFIER seat: modifiers don't change with
// the host input source, so this is the only free real estate that stays free in
// both layouts. Every symbol seat is a live Cyrillic letter under ЙЦУКЕН —
// '[' is х (5.5/day), ';' is ж, '/' is '.' — and the two genuinely dead ones
// (']' 2.1, ъ 0.6) sit in the worst reach on the board. See stats/keycount-2026-07.md.
// Under a US input source this key types '&'. The board cannot see the layout;
// cross-layout '?' would need Karabiner's input_source_if.
// Space and Enter stay PLAIN on the board. Their hold-layers live in Karabiner
// instead (asset lily58-thumb-layers.json): a variable set on press, so the
// layer engages instantly with no tapping term. ZMK's stock &lt cannot do that —
// tap-preferred makes you hold past 200ms first, and Studio can only set a
// hold-tap's two parameters, never its flavor. A whitelist behavior
// (hold-trigger-key-positions) would match Karabiner's feel, and that is the one
// thing on this board still worth a reflash.
// Seat 50 (CURSE) and pos 11 (HEAVEN) stay as the board-side doors to the same
// two layers.
//
// F13 left the board entirely: it is RAlt+H in Karabiner now, so the
// superwhisper trigger is a right-thumb chord instead of a pinky-corner hold.
// The '|' on HEAVEN went with it — dead weight.
//
// 2026-08-29 — RAlt takes seat 55, the mirror of LAlt at 52. That symmetry is
// the point: both alts on the prime thumb seats, one story for both hands.
// Arrows move off the HEAVEN layer onto RAlt + I/J/K/L in Karabiner (mod
// stripped, so the OS sees a bare arrow — aerospace never fires). Same thumb,
// same seat, same fingers as before; only the mechanism changed, and a
// modifier costs no tapping term.
// HEAVEN keeps a plain base trigger on pos 11, the dead ']' corner (2.1/day) —
// cold content only now, and the fallback path to arrows whenever Karabiner is
// off. ']' / ъ rehomed to HEAVEN + the '0' key.
            display-name = "ground";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &mo 2
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y  &kp U    &kp I     &kp O   &kp P    &kp LBKT
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                         &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp LS(N7)
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp EQUAL   &kp MINUS  &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &mo 1 &kp LGUI &kp LALT &lt 1 SPACE   &lt 2 RET &kp RALT &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        curse_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       | F11 | F12 | F17  | F18  | RET  |                   |      |   7   |   8   |  9   |       |  F12  |
// |       |     |     |cmd+K |  K   |C(SPC)|                   |      |   4   |   5   |  6   |       |       |
// | CAPS  |     |     | F17  | F18  |      |        |  |       |      |   1   |   2   |  3   |       |       |
//                      |      |      |      |   `    |  |       |  0   |       |  KP.  |
            display-name = "CURSE";
            bindings = <
&trans   &kp F1 &kp F2 &kp F3  &kp F4  &kp F5                        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&trans   &kp F11 &kp F12 &kp F17 &kp F18 &kp RET                     &trans &kp N7 &kp N8 &kp N9 &trans  &kp F12
&trans   &trans &trans &kp LG(K) &kp K   &kp LC(SPACE)               &trans &kp N4 &kp N5 &kp N6 &trans  &trans
&kp CAPS &trans &trans &kp F17 &kp F18 &trans &trans      &trans     &trans &kp N1 &kp N2 &kp N3 &trans  &trans
                       &trans  &trans  &trans &kp GRAVE   &trans     &kp N0 &trans &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        heaven_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     | KP@ |      |      |      |                   |BT_CLR|BT_SEL0|BT_PRV |BT_NXT|   ]   |  KP+  |
// |       |     |     |      |      |      |                   |      |       |   ^   |      |       |       |
// |       |     |     |      |      |      |                   |      |  <-   |   v   |  ->  |       |       |   inverted-T arrow cross
// |       |     |     |      |      |      |        |  |  F16  |      |       |       |      |       |       |
//                      |      |      |      |        |  |   '   | tog1 |  DEL  |       |   (tog1 numpad-lock chord is BROKEN: it sits on
//                                                                                          HEAVEN's own mo seat after the thumb reshuffle —
//                                                                                          unreachable while holding HEAVEN; fix pending)
            display-name = "HEAVEN";
            bindings = <
&trans  &trans  &kp 0x700CE &trans &trans &trans                &bt BT_CLR &bt BT_SEL 0 &bt BT_PRV &bt BT_NXT &kp RBKT &kp KP_PLUS
&trans  &trans  &trans  &trans &trans &trans                    &trans     &trans       &kp UP     &trans     &trans &trans
&trans  &trans  &trans  &trans &trans &trans                    &trans     &kp LEFT     &kp DOWN   &kp RIGHT  &trans &trans
&trans  &trans  &trans  &trans &trans &trans &trans   &kp F16   &trans     &trans       &trans       &trans   &trans &trans
                        &trans &trans &trans &trans   &kp SQT   &tog 1     &kp DEL      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        media_layer {
// ------------------------------------------------------------------------------------------------------------
// media/system layer (no name in Studio; nothing currently points at it).
// 0xC0079 / 0xC007A are consumer-page keyboard illumination up/down —
// no named define in keys.h, raw HID usages by design.
// |       |BRI_DN|BRI_UP|     |KBD_DN|KBD_UP|                  |VOL_UP|  RW   | PLAY  |  FF  | MUTE  |VOL_DN |
            display-name = "media";
            bindings = <
&none &kp C_BRI_DN &kp C_BRI_UP &none &kp 0xC007A &kp 0xC0079    &kp C_VOL_UP &kp C_RW &kp C_PP &kp C_FF &kp C_MUTE &kp C_VOL_DN
&none &none &none &none &none &none                              &none &none &none &none &none &none
&trans &trans &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &trans
&none &none &none &none &none &none &none                &none   &none &none &none &none &none &none
                  &none &none &none &none                &none   &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
