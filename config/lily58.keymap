 * SPDX-License-Identifier: MIT
 *
 * MIRROR of the live board state as managed by ZMK Studio.
 * Source of truth is the Studio flash settings on the board itself; this file
 * is the backup/documentation copy, dumped over Studio RPC (tools/zmkctl.py).
 * If reflashed, Studio's saved state still overrides these defaults — which is
 * also the day this file starts mattering, so it has to be true before a build.
 *
 * Verified cell-by-cell against the board 2026-09-08, closing the kitchen
 * window that opened 2026-08-31: all 58 positions on all five bound layers
 * compared as numeric (page, id, mods), not display names.
 * Edits made in the Studio GUI do NOT reach this file — re-verify after any.
 *
 * HEAVEN pos 2 is a bare keyboard-page usage 0xCE (Keypad @), which macOS
 * ignores. It reads like a Studio slip that ate the old F15 (and F14 next to
 * it) rather than a decision; recorded here as-is because this file's job is
 * to say what the board does, not what it ought to.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Tap-toggle duals for slow, deliberate keys only (thumbs/layer keys) —
        // hold resolves instantly via balanced flavor when chorded, tap fires on
        // clean press-release. Board-wide doctrine stays: no hold-taps on typing keys.
        // Nothing binds the gtog ladder at the moment; it stays compiled in
        // because pruning a behavior shifts every id above it, and Studio's
        // saved bindings reference ids. Dead weight is cheaper than a reshuffle.
        gtog: gui_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
        // Tapping-term ladder — same behavior at faster terms, so tuning the
        // hold-engage delay is a runtime rebind (Studio/RPC), never a reflash.
        gtog180: gui_tap_toggle_180 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&tog>;
        };
        gtog160: gui_tap_toggle_160 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            bindings = <&kp>, <&tog>;
        };
        gtog140: gui_tap_toggle_140 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            bindings = <&kp>, <&tog>;
        };
        // Thumb hold-layers — balanced regime, 2026-08-31. The previous design
        // (hold-preferred + a compiled position whitelist, zero clocks) made
        // every key added to a layer a whitelist edit -> rebuild -> flash both
        // halves. That tax lost: bekh types slowly now, so a timer's misfire
        // window is cheap, and with no whitelist every position is
        // layer-capable — layer content is pure Studio RPC, forever.
        //
        // balanced semantics:
        //   other key pressed AND released while thumb is down -> hold, no wait
        //   thumb released first (fast roll)                   -> tap
        //   thumb held alone past the term                     -> hold
        //   thumb released alone within the term               -> tap, on release
        //
        // The term's only real job is how long a solo press may dwell before
        // the tap is forfeited: spaces vanishing = raise it. quick-tap-ms:
        // tap, then press again within 200ms -> forced tap, held = key repeat.
        //
        // Five rungs so tuning the term is a runtime rebind (Studio RPC),
        // never a reflash — the gtog ladder trick. ltb280 is the default;
        // one behavior serves both thumbs (the layer is a binding parameter).
        // Prune = behavior IDs shift under Studio's saved bindings; don't.
        ltb200: layer_tap_balanced_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb240: layer_tap_balanced_240 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb280: layer_tap_balanced_280 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb320: layer_tap_balanced_320 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <320>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb360: layer_tap_balanced_360 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <360>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        motog: momentary_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    // Both thumb layers held together open LIMBO (word-motion: the HEAVEN
    // arrow cross positions, but with Alt chords). Indices are FIRMWARE layer
    // slots: 1=CURSE, 2=HEAVEN, 4=limbo_layer — which was extra_2, the first
    // reserved slot, where Studio put bekh's LIMBO layer (media, id 3, was
    // deleted in the Studio kitchen 2026-09 and then reused as 'shit'; ids
    // don't recycle). If layers are ever re-mirrored/reordered, re-check these
    // numbers before trusting them.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        limbo_tri {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   ]   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// | SHIT  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   ?   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   =    |  |   -   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                      |LCTRL | LALT | LGUI |SPC/CUR |  |RET/HVN| RGUI | BSPC  | RCTRL |
//
// LAYER DOORS, 2026-09-08 — the base layer no longer carries a plain &mo to
// CURSE or HEAVEN anywhere. Both live exclusively on the thumb hold-taps:
// Space (pos 53) holds CURSE, Enter (pos 54) holds HEAVEN, and holding both
// opens LIMBO via the conditional_layers node. The two old board-side doors
// are gone: seat 50 (was &mo 1) is LCTRL now, pos 11 (was &mo 2) is ']'.
// The only non-thumb door on the board is &mo 3 at pos 24 -> 'shit'.
// Consequence worth knowing: if a thumb hold-tap ever misbehaves, there is no
// fallback route to CURSE or HEAVEN except HEAVEN's own &tog 1 at pos 55.
//
// thumbs: modifiers occupy the three inner-left seats (LCTRL/LALT/LGUI) and
// the outer-right pair (RGUI ... RCTRL), with Space and Enter holding the two
// layers between them. LAlt keeps a prime seat because aerospace lives on alt —
// top measured modifier, ~260 chords/day, one-handed left by requirement.
// pos 24 gave up LCTRL to become the 'shit' door; LCTRL rehomed to thumb 50.
//
// pos 35 (never RCTRL in practice) is '?' — LS(N7), literally the ЙЦУКЕН chord,
// just folded onto one key. It had to be a MODIFIER seat: modifiers don't change
// with the host input source, so this is the only free real estate that stays
// free in both layouts. Every symbol seat is a live Cyrillic letter under
// ЙЦУКЕН — '[' is х (5.5/day), ';' is ж, '/' is '.' — and the two genuinely
// dead ones (']' 2.1, ъ 0.6) sit in the worst reach on the board.
// See stats/keycount-2026-07.md.
// Under a US input source this key types '&'. The board cannot see the layout;
// cross-layout '?' would need Karabiner's input_source_if.
//
// This lived in Karabiner for one afternoon; Karabiner was instant but kept a
// second copy of both layers in scancodes — two sources of truth, one of which
// was going to rot. Firmware won, first as hold-preferred + whitelist, since
// 2026-08-31 as the balanced ladder (Studio can set a hold-tap's parameters
// but never its flavor or term, hence five compiled rungs).
//
// F13 left the board entirely: it is RAlt+H in Karabiner now, so the
// superwhisper trigger is a right-thumb chord instead of a pinky-corner hold.
//
// Arrows also live on RAlt + I/J/K/L in Karabiner (mod stripped, so the OS sees
// a bare arrow — aerospace never fires). HEAVEN keeps its own arrow cross as
// the fallback path whenever Karabiner is off.
            display-name = "ground";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp RBKT
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y  &kp U    &kp I     &kp O   &kp P    &kp LBKT
&mo 3     &kp A  &kp S  &kp D    &kp F    &kp G                         &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp LS(N7)
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp EQUAL   &kp MINUS  &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LCTRL &kp LALT &kp LGUI &ltb280 1 SPACE   &ltb280 2 RET &kp RGUI &kp BSPC &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        curse_layer {
// ------------------------------------------------------------------------------------------------------------
// |LA(ESC)|LA(1)|LA(2)|LA(3) |LA(4) |LA(5) |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |LA(TAB)| F11 | F12 |LS+LA(F)|LA(R)| RET |                   |      |   7   |   8   |  9   |       |  F12  |
// |       |LA(A)|LA(S)|LA(D) |LA(F) |LA(G) |                   |      |   4   |   5   |  6   |       |       |
// | CAPS  |     |     | F17  |LA(V) |LA(B) |LA(SPC) |  |       |      |   1   |   2   |  3   |       |       |
//                      |      |      |LG(Q) |   `    |  |   '   |  0   |LA(BSPC)|  KP. |
//
// Left hand is aerospace: LA(letter) window/workspace commands, LA(ESC)+LA(1-5)
// for workspace switching. Right hand is the numpad.
// CAPS squats on the left shift seat (pos 36) — that is why a left-shifted
// chord has to be pressed shift-before-Space; right shift composes in any order.
            display-name = "CURSE";
            bindings = <
&kp LA(ESC) &kp LA(N1) &kp LA(N2) &kp LA(N3)    &kp LA(N4) &kp LA(N5)                     &kp F6  &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&kp LA(TAB) &kp F11    &kp F12    &kp LS(LA(F)) &kp LA(R)  &kp RET                        &trans  &kp N7 &kp N8 &kp N9 &trans  &kp F12
&trans      &kp LA(A)  &kp LA(S)  &kp LA(D)     &kp LA(F)  &kp LA(G)                      &trans  &kp N4 &kp N5 &kp N6 &trans  &trans
&kp CAPS    &trans     &trans     &kp F17       &kp LA(V)  &kp LA(B) &kp LA(SPACE) &trans &trans  &kp N1 &kp N2 &kp N3 &trans  &trans
                                  &trans        &trans     &kp LG(Q) &kp GRAVE     &kp SQT &kp N0 &kp LA(BSPC) &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        heaven_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     | KP@ |      |      |      |                   |BT_CLR|BT_SEL0|BT_PRV |BT_NXT|   ]   |  KP+  |
// |       |     |     |      |      |      |                   |LA(Y) |       |   ^   |      |       |       |
// |       |     |     |      |      |      |                   |LA(<-)|  <-   |   v   |  ->  |LA(->) |       |   inverted-T arrow cross
// |       |     |     |      |      |      |        |  |  F16  | F13  |  F18  |   |   |      |       |       |
//                      |      |      |      |    `   |  |   '   | tog1 |  DEL  |       |
//
// tog1 at pos 55 is the numpad latch — and it is the ONE door to CURSE that
// does not go through a thumb hold-tap, so it doubles as the escape hatch.
// Reachable now that HEAVEN is held on the opposite thumb (pos 54).
            display-name = "HEAVEN";
            bindings = <
&trans  &trans  &kp 0x700CE &trans &trans &trans                &bt BT_CLR   &bt BT_SEL 0 &bt BT_PRV  &bt BT_NXT   &kp RBKT &kp KP_PLUS
&trans  &trans  &trans  &trans &trans &trans                    &kp LA(Y)    &trans       &kp UP      &trans       &trans &trans
&trans  &trans  &trans  &trans &trans &trans                    &kp LA(LEFT) &kp LEFT     &kp DOWN    &kp RIGHT    &kp LA(RIGHT) &trans
&trans  &trans  &trans  &trans &trans &trans &trans   &kp F16   &kp F13      &kp F18      &kp LS(BSLH) &trans      &trans &trans
                        &trans &trans &trans &kp GRAVE   &kp SQT   &tog 1     &kp DEL      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        shit_layer {
// ------------------------------------------------------------------------------------------------------------
// The junk drawer, firmware slot 3. Was 'media' until it was deleted in the
// Studio kitchen and came back on the 2026-09-01 reflash with firmware
// defaults; bekh renamed it and bolted a door on it (&mo 3 at pos 24), which
// is what turned it from an inert slot into the layer he actually reaches.
// |  F11  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F12  |
// |       |     |LC(L)|LG(I) |      |      |                   |      |       |       |      |       |       |
// |       |     |     |LG(K) |      |      |                   |      |       |       |      |       |       |
//
// 2026-09-08: the whole num row was media/brightness consumer-page usages
// (BRI_DN/BRI_UP, keyboard illumination, VOL/RW/PLAY/FF/MUTE); wiped for F1-F12.
// F1-F10 sit under the digit they are named after — that alignment is the whole
// point, so the two overflow keys take the seats that have no digit: F11 on the
// ESC corner, F12 on the ']' corner.
// Volume survives on the rotary encoder (sensor-bindings, every layer).
            display-name = "shit";
            bindings = <
&kp F11 &kp F1 &kp F2 &kp F3   &kp F4    &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F12
&none  &none  &kp LC(L) &kp LG(I) &none  &none                   &none  &none  &none  &none   &none   &none
&trans &trans &trans &kp LG(K) &trans    &trans                  &trans &trans &trans &trans  &trans  &trans
&none  &none  &none  &none     &none     &none  &none    &none   &none  &none  &none  &none   &none   &none
                     &none     &none     &none  &none    &none   &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        limbo_layer {
// ------------------------------------------------------------------------------------------------------------
// LIMBO, firmware slot 4 (was extra_2, a reserved slot Studio activated).
// Opens only as the conditional layer: Space + Enter held together.
// Word-motion cross — the same four seats HEAVEN uses for arrows, but Alt'd,
// so it is jump-by-word instead of jump-by-character.
// |       |     |     |      |      |      |                   |      |       |LA(^)  |      |       |       |
// |       |     |     |      |      |      |                   |LA(<-)|LA(v)  |LA(->) |      |       |       |
//
// Everything else is empty. It was empty on the board as behavior id 0 —
// zeroed bindings in a never-defined reserved layer — written out here as
// &none, which is the same thing with a name. NOTE: this block only becomes
// the firmware default on the next build; today LIMBO exists solely in Studio
// flash settings, so a settings_reset before a rebuild would lose it.
            display-name = "LIMBO";
            bindings = <
&none &none &none &none &none &none                              &none &none &none        &none  &none &none
&none &none &none &none &none &none                              &none &none &kp LA(UP)   &none  &none &none
&none &none &none &none &none &none                              &none &kp LA(LEFT) &kp LA(DOWN) &kp LA(RIGHT) &none &none
&none &none &none &none &none &none &none                &none   &none &none &none        &none  &none &none
                  &none &none &none &none                &none   &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_3 {
            status = "reserved";
        };
    };
};
