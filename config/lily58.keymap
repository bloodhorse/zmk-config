 *
 * MIRROR of the live board. The source of truth is ZMK Studio's saved state
 * on the board, which overrides these defaults even after a reflash. Keep it
 * true with `tools/zmkctl.py verify`; a Studio GUI edit never reaches this
 * file. Cells are QWERTY scancodes; Karabiner makes them Gallium, chords
 * included. See CLAUDE.md and docs/.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Behavior ids come from this order and Studio's saved bindings
        // reference them: append new behaviors at the end, never prune or
        // reorder. gtog* and motog are unbound and stay for that reason.
        gtog: gui_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
        gtog180: gui_tap_toggle_180 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&tog>;
        };
        gtog160: gui_tap_toggle_160 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            bindings = <&kp>, <&tog>;
        };
        gtog140: gui_tap_toggle_140 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            bindings = <&kp>, <&tog>;
        };
        // Layer hold-tap ladder: same balanced behavior at five terms, so tuning
        // a hold is a rebind over RPC, never a build (docs/board.md).
        ltb200: layer_tap_balanced_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb240: layer_tap_balanced_240 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb280: layer_tap_balanced_280 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb320: layer_tap_balanced_320 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <320>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        ltb360: layer_tap_balanced_360 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <360>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        motog: momentary_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
        // Mod hold-tap ladder, same regime. Unbound since Space went to mtp150.
        mtb240: mod_tap_balanced_240 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        mtb280: mod_tap_balanced_280 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        mtb320: mod_tap_balanced_320 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <320>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        // Hold-preferred ladders: any other key while held is the hold, at once;
        // a press within the prior-idle window of the last key is a tap on
        // press. The ladder is on the idle window, the term stays 280.
        mtp100: mod_tap_preferred_idle_100 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
        mtp150: mod_tap_preferred_idle_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        mtp200: mod_tap_preferred_idle_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        ltp100: layer_tap_preferred_idle_100 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
        ltp150: layer_tap_preferred_idle_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
        ltp200: layer_tap_preferred_idle_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   ]   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// | ~/FUCK|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |?/FUCK |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   =    |  |   -   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                      | SHIT |LCTRL | LGUI |SPC/ALT |  |RET/HVN| RGUI | BSPC  | SHIT  |
//
// pos 35 '?' is LS(N7), the ЙЦУКЕН chord on one key; Karabiner's EN-gated
// shift+7 -> ? covers English. It had to be a modifier seat: every symbol
// seat is a live Cyrillic letter under ЙЦУКЕН.
            display-name = "ground";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp RBKT
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y  &kp U    &kp I     &kp O   &kp P    &kp LBKT
&ltp150 4 GRAVE &kp A &kp S &kp D &kp F  &kp G                         &kp H  &kp J    &kp K     &kp L   &kp SEMI &ltp150 4 LS(N7)
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp EQUAL   &kp MINUS  &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &mo 3    &kp LCTRL &kp LGUI &mtp150 LALT SPACE &ltp150 2 RET &kp RGUI &kp BSPC &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        curse_layer {
// Dead weight: no hold door, reachable only through HEAVEN's &tog 1 (pos 55).
// Its alt cells and numpad went redundant when Space became a real alt and
// Karabiner took the numpad.
            display-name = "CURSE";
            bindings = <
&kp LA(ESC) &kp LA(N1) &kp LA(N2) &kp LA(N3)    &kp LA(N4) &kp LA(N5)                         &kp F6  &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&kp LA(TAB) &kp LA(B)  &kp LA(L)  &kp LA(D)     &kp LA(C)  &kp RET                        &kp LA(J) &kp N7 &kp N8 &kp N9 &trans  &kp F12
&kp LS(GRAVE) &kp LA(N)  &kp LA(R)  &kp LA(T)     &kp LA(S)  &kp LA(G)                      &kp LA(P) &kp N4 &kp N5 &kp N6 &kp LA(I) &trans
&trans      &kp LA(X)  &kp LA(Q)  &kp LA(M)     &kp LA(W)  &kp LA(Z) &kp LA(SPACE) &trans &kp LA(K) &kp N1 &kp N2 &kp N3 &trans  &trans
                                  &trans        &trans     &kp CAPS  &kp GRAVE     &kp SQT &kp N0 &kp LA(BSPC) &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        heaven_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     | KP@ |      |      |      |                   |BT_CLR|BT_SEL0|BT_PRV |BT_NXT|   ]   |  KP+  |
// |       |     |     |      |      |      |                   |LA(J) |LA+LG(Y)|  ^   |      |       |       |
// |       |     |     |      |      |      |                   |LA(<-)|  <-   |   v   |  ->  |LA(->) |       |
// |       |     |     |      |      |      |        |  |  F16  | F13  |  F18  |   |   |LG(I) |   K   |       |
//                      |      |      |      |    `   |  |   '   | tog1 |  DEL  |       |
//
// Door: Enter held (pos 54). pos 2 is a bare 0xCE (Keypad @), ignored by macOS.
            display-name = "HEAVEN";
            bindings = <
&trans  &trans  &kp 0x700CE &trans &trans &trans                &bt BT_CLR   &bt BT_SEL 0 &bt BT_PRV  &bt BT_NXT   &kp RBKT &kp KP_PLUS
&trans  &trans  &trans  &trans &trans &trans                    &kp LA(Y)    &kp LA(LG(U)) &kp UP     &trans       &trans &trans
&trans  &trans  &trans  &trans &trans &trans                    &kp LA(LEFT) &kp LEFT     &kp DOWN    &kp RIGHT    &kp LA(RIGHT) &trans
&trans  &trans  &trans  &trans &trans &trans &trans   &kp F16   &kp F13      &kp F18      &kp LS(BSLH) &kp LG(I)   &kp K  &trans
                        &trans &trans &trans &kp GRAVE   &kp SQT   &tog 1     &kp DEL      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        shit_layer {
// ------------------------------------------------------------------------------------------------------------
// |BT_SEL3|  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |  F12  |
// |       |     |     |LG(K) |      |      |                   |      |       |       |      |       |       |
// | CAPS  |     |LC(L)|LA+LG(C)|    |      |        |  |       |      |       |       |      |       |       |
//
// Door: &mo 3 on both outer thumbs (50, 57). F1-F10 under their digits.
// LA(LG(C)) is alt+cmd+m after Karabiner, hyprshit's mode.
// The '&' cell is RS(N7), not LS(N7), on purpose: Karabiner's shift+7 -> ?
// is keyed on left shift. The api's Keycode enum can't name it; it went in raw
// (zmkctl kp 3 19 0x20070024).
            display-name = "shit";
            bindings = <
&bt BT_SEL 3 &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&none  &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)    &kp LS(N6) &kp RS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp F12
&trans &trans &trans &kp LG(K) &trans    &trans                  &trans &trans &trans &trans  &trans  &trans
&kp CAPS  &none  &kp LC(L) &kp LA(LG(C)) &none  &none  &kp LC(LA(SPACE))    &none   &none  &none  &none  &none   &none   &none
                     &none     &none     &none  &none    &none   &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fuck_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |LG+LS(3)|LG+LS(4)|  |                   |      |       |       |      |       |       |
// |       |     |HYP+F14|HYP+F15|HYP+F16|      |                   |      |       |       |      |       |       |
// |       |LC+LS(A)|LG(2)|LG(3)|LG(4)|LG(5)|                   |      |       |       |LA(F18)|      |       |
// |       |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                      |      |      |      | LA(`)  |  |       |      |       |       |
//
// Doors: pos 24 and pos 35 held (ltp150). cmd+digit under each digit for
// one-handed tab switching; hyper+F14/F15 toggle the centre and right screens, hyper+F16 clears the desktop.
            display-name = "FUCK";
            bindings = <
&trans &trans      &trans      &kp LG(LS(N3)) &kp LG(LS(N4)) &trans          &trans &trans &trans &trans &trans &trans
&trans &trans      &kp LC(LS(LA(LG(F14)))) &kp LC(LS(LA(LG(F15)))) &kp LC(LS(LA(LG(F16)))) &trans  &trans &trans &trans &trans &trans &trans
&trans &kp LC(LS(A)) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)             &trans &trans &trans &kp LA(F18) &trans &trans
&trans &trans      &trans      &trans      &trans      &trans  &trans    &trans  &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &kp LA(GRAVE)                 &trans   &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
