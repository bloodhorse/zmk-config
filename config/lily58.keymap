 *
 * MIRROR of the live board state as managed by ZMK Studio (2026-07-11).
 * Source of truth is the Studio flash settings on the board itself; this file
 * is the backup/documentation copy, dumped over Studio RPC (tools/zmkctl.py).
 * If reflashed, Studio's saved state still overrides these defaults.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Tap-toggle duals for slow, deliberate keys only (thumbs/layer keys) —
        // hold resolves instantly via balanced flavor when chorded, tap fires on
        // clean press-release. Board-wide doctrine stays: no hold-taps on typing keys.
        gtog: gui_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
        // Tapping-term ladder — same behavior at faster terms, so tuning the
        // hold-engage delay is a runtime rebind (Studio/RPC), never a reflash.
        gtog180: gui_tap_toggle_180 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&kp>, <&tog>;
        };
        gtog160: gui_tap_toggle_160 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            bindings = <&kp>, <&tog>;
        };
        gtog140: gui_tap_toggle_140 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            bindings = <&kp>, <&tog>;
        };
        motog: momentary_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   ]   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// | CURSE |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |HEAVEN |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   =    |  |   -   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                      | CTRL | ALT  | GUI  | SPACE  |  | ENTER |GUI/t1| BSPC  | RALT  |   (GUI/t1: hold=RGUI, tap=toggle CURSE numpad)
            display-name = "ground";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp RBKT
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y  &kp U    &kp I     &kp O   &kp P    &kp LBKT
&mo 1     &kp A  &kp S  &kp D    &kp F    &kp G                         &kp H  &kp J    &kp K     &kp L   &kp SEMI &mo 2
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp EQUAL   &kp MINUS  &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LCTRL &kp LALT &kp LGUI &kp SPACE   &kp RET &gtog RGUI 1 &kp BSPC &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        curse_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       |     |     | F17  | F18  |      |                   |      |   7   |   8   |  9   |       |  F12  |
// |       |     |     |      | F16  |C(SPC)|                   |      |   4   |   5   |  6   |       |       |
// | CAPS  |     |     |      | RET  |      |        |  |       |      |   1   |   2   |  3   |       |       |
//                      |      |      |      |   `    |  |       |      |   0   |   .   |
            display-name = "CURSE";
            bindings = <
&trans   &kp F1 &kp F2 &kp F3  &kp F4  &kp F5                        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&trans   &trans &trans &kp F17 &kp F18 &trans                        &trans &kp N7 &kp N8 &kp N9 &trans  &kp F12
&trans   &trans &trans &trans  &kp F16 &kp LC(SPACE)                 &trans &kp N4 &kp N5 &kp N6 &trans  &trans
&kp CAPS &trans &trans &trans  &kp RET &trans &trans      &trans     &trans &kp N1 &kp N2 &kp N3 &trans  &trans
                       &trans  &trans  &trans &kp GRAVE   &trans     &trans &kp N0 &kp DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        heaven_layer {
// ------------------------------------------------------------------------------------------------------------
// |  F13  | F14 | F15 |      |      |      |                   |BT_CLR|BT_SEL0|BT_PRV |BT_NXT|       |  KP+  |
// |       |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |   ]   |
// |       |     |     |      |      |      |                   |  <-  |   v   |   ^   |  ->  |       |       |
// |       |     |     |      |      |      |        |  |  F16  |      |       |   |   |      |       |       |
//                      |      |      |      |        |  |   '   |      |  DEL  |  F13  |
            display-name = "HEAVEN";
            bindings = <
&kp F13 &kp F14 &kp F15 &trans &trans &trans                    &bt BT_CLR &bt BT_SEL 0 &bt BT_PRV &bt BT_NXT &trans &kp KP_PLUS
&trans  &kp N1  &kp N2  &kp N3 &kp N4 &kp N5                    &kp N6     &kp N7       &kp N8     &kp N9     &kp N0 &kp RBKT
&trans  &trans  &trans  &trans &trans &trans                    &kp LEFT   &kp DOWN     &kp UP     &kp RIGHT  &trans &trans
&trans  &trans  &trans  &trans &trans &trans &trans   &kp F16   &trans     &trans       &kp LS(BSLH) &trans   &trans &trans
                        &trans &trans &trans &trans   &kp SQT   &trans     &kp DEL      &kp F13
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        media_layer {
// ------------------------------------------------------------------------------------------------------------
// media/system layer (no name in Studio; nothing currently points at it).
// 0xC0079 / 0xC007A are consumer-page keyboard illumination up/down —
// no named define in keys.h, raw HID usages by design.
// |       |BRI_DN|BRI_UP|     |KBD_DN|KBD_UP|                  |VOL_UP|  RW   | PLAY  |  FF  | MUTE  |VOL_DN |
            display-name = "media";
            bindings = <
&none &kp C_BRI_DN &kp C_BRI_UP &none &kp 0xC007A &kp 0xC0079    &kp C_VOL_UP &kp C_RW &kp C_PP &kp C_FF &kp C_MUTE &kp C_VOL_DN
&none &none &none &none &none &none                              &none &none &none &none &none &none
&trans &trans &trans &trans &trans &trans                        &trans &trans &trans &trans &trans &trans
&none &none &none &none &none &none &none                &none   &none &none &none &none &none &none
                  &none &none &none &none                &none   &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
